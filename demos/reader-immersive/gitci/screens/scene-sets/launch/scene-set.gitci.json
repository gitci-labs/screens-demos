{
  "$schema": "https://screens.gitci.com/schemas/scene-set.gitci.schema.json",
  "schemaVersion": 1,
  "id": "launch",
  "name": "Reader Immersive Launch",
  "entry": "./scene-set.tsx",
  "export": "sceneSet",
  "targets": [
    "appstore.iphone.6_9.portrait",
    "appstore.ipad.13.portrait",
    "appstore.mac.16_10"
  ],
  "appearanceByTarget": {
    "appstore.*": "light"
  },
  "theme": {
    "id": "gitci.theme.clean-editorial",
    "overrides": {
      "--gitci-color-bg": "#fff7ed",
      "--gitci-color-fg": "#1c1917",
      "--gitci-color-primary": "#dc2626",
      "--gitci-color-secondary": "#7c2d12"
    }
  },
  "variantGroups": [
    {
      "id": "baseline",
      "name": "Baseline",
      "selections": {
        "read@appstore.iphone.*": "iphone",
        "read@appstore.ipad.*": "ipad",
        "read@appstore.mac.*": "mac"
      }
    },
    {
      "id": "ppo-a",
      "name": "Product Page Optimization A",
      "selections": {
        "read@appstore.iphone.*": "iphone-conversion",
        "read@appstore.ipad.*": "ipad",
        "read@appstore.mac.*": "mac"
      }
    }
  ],
  "slots": [
    {
      "id": "read",
      "label": "Reading",
      "variants": [
        {
          "id": "iphone",
          "sceneTemplate": "gitci.core.feature-closeup",
          "includeTargets": [
            "appstore.iphone.*"
          ],
          "props": {
            "eyebrow": {
              "kind": "localized",
              "key": "read.eyebrow.iphone",
              "fallback": "Read deeply"
            },
            "headline": {
              "kind": "localized",
              "key": "read.headline.iphone",
              "fallback": "Turn any passage into study material"
            },
            "subheadline": {
              "kind": "localized",
              "key": "read.subheadline.iphone",
              "fallback": "Tap words, save discoveries, and keep reading without breaking flow."
            },
            "featureTitle": {
              "kind": "localized",
              "key": "read.featureTitle.iphone",
              "fallback": "Instant lookup"
            },
            "featureBody": {
              "kind": "localized",
              "key": "read.featureBody.iphone",
              "fallback": "Definitions and notes stay close to the text you care about."
            },
            "screenshot": {
              "kind": "asset",
              "path": "../../assets/iphone/reader.svg",
              "alt": "Reader app screenshot"
            },
            "device": "iphone-2d"
          }
        },
        {
          "id": "iphone-conversion",
          "sceneTemplate": "gitci.core.feature-closeup",
          "includeTargets": [
            "appstore.iphone.*"
          ],
          "props": {
            "eyebrow": {
              "kind": "localized",
              "key": "read.eyebrow.iphone.conversion",
              "fallback": "Read in flow"
            },
            "headline": {
              "kind": "localized",
              "key": "read.headline.iphone.conversion",
              "fallback": "Learn from the articles you already want to read"
            },
            "subheadline": {
              "kind": "localized",
              "key": "read.subheadline.iphone.conversion",
              "fallback": "Tap a word, save it, and return to the sentence without losing your place."
            },
            "featureTitle": {
              "kind": "localized",
              "key": "read.featureTitle.iphone.conversion",
              "fallback": "Built for momentum"
            },
            "featureBody": {
              "kind": "localized",
              "key": "read.featureBody.iphone.conversion",
              "fallback": "Variant groups can test sharper App Store copy while reusing the same screenshots."
            },
            "screenshot": {
              "kind": "asset",
              "path": "../../assets/iphone/reader.svg",
              "alt": "Reader app screenshot"
            },
            "device": "iphone-2d"
          }
        },
        {
          "id": "ipad",
          "sceneTemplate": "gitci.core.feature-closeup",
          "includeTargets": [
            "appstore.ipad.*"
          ],
          "props": {
            "eyebrow": {
              "kind": "localized",
              "key": "read.eyebrow.ipad",
              "fallback": "Study in context"
            },
            "headline": {
              "kind": "localized",
              "key": "read.headline.ipad",
              "fallback": "Reading and review side by side"
            },
            "subheadline": {
              "kind": "localized",
              "key": "read.subheadline.ipad",
              "fallback": "A wider layout makes notes, highlights, and vocabulary visible together."
            },
            "featureTitle": {
              "kind": "localized",
              "key": "read.featureTitle.ipad",
              "fallback": "Focused workspace"
            },
            "featureBody": {
              "kind": "localized",
              "key": "read.featureBody.ipad",
              "fallback": "Use the same scene template with a target-specific asset and copy."
            },
            "screenshot": {
              "kind": "asset",
              "path": "../../assets/ipad/study.svg",
              "alt": "Reader study workspace screenshot"
            },
            "device": "ipad-2d"
          }
        },
        {
          "id": "mac",
          "sceneTemplate": "gitci.core.feature-closeup",
          "includeTargets": [
            "appstore.mac.*"
          ],
          "props": {
            "eyebrow": {
              "kind": "localized",
              "key": "read.eyebrow.mac",
              "fallback": "Review"
            },
            "headline": {
              "kind": "localized",
              "key": "read.headline.mac",
              "fallback": "Keep a library of what you learned"
            },
            "subheadline": {
              "kind": "localized",
              "key": "read.subheadline.mac",
              "fallback": "Mac screenshots can use the same data model with desktop-specific framing."
            },
            "featureTitle": {
              "kind": "localized",
              "key": "read.featureTitle.mac",
              "fallback": "Review dashboard"
            },
            "featureBody": {
              "kind": "localized",
              "key": "read.featureBody.mac",
              "fallback": "This demo uses fake assets only, ready for public examples."
            },
            "screenshot": {
              "kind": "asset",
              "path": "../../assets/mac/library.svg",
              "alt": "Reader library screenshot"
            },
            "device": "mac-2d"
          }
        }
      ]
    }
  ],
  "locales": [
    {
      "id": "en-US",
      "name": "English (US)",
      "strings": {
        "read.eyebrow.iphone": "Read deeply",
        "read.headline.iphone": "Turn any passage into study material",
        "read.subheadline.iphone": "Tap words, save discoveries, and keep reading without breaking flow.",
        "read.featureTitle.iphone": "Instant lookup",
        "read.featureBody.iphone": "Definitions and notes stay close to the text you care about.",
        "read.eyebrow.iphone.conversion": "Read in flow",
        "read.headline.iphone.conversion": "Learn from the articles you already want to read",
        "read.subheadline.iphone.conversion": "Tap a word, save it, and return to the sentence without losing your place.",
        "read.featureTitle.iphone.conversion": "Built for momentum",
        "read.featureBody.iphone.conversion": "Variant groups can test sharper App Store copy while reusing the same screenshots.",
        "read.eyebrow.ipad": "Study in context",
        "read.headline.ipad": "Reading and review side by side",
        "read.subheadline.ipad": "A wider layout makes notes, highlights, and vocabulary visible together.",
        "read.featureTitle.ipad": "Focused workspace",
        "read.featureBody.ipad": "Use the same scene template with a target-specific asset and copy.",
        "read.eyebrow.mac": "Review",
        "read.headline.mac": "Keep a library of what you learned",
        "read.subheadline.mac": "Mac screenshots can use the same data model with desktop-specific framing.",
        "read.featureTitle.mac": "Review dashboard",
        "read.featureBody.mac": "This demo uses fake assets only, ready for public examples."
      }
    },
    {
      "id": "ja-JP",
      "name": "Japanese",
      "strings": {
        "read.eyebrow.iphone": "深く読む",
        "read.headline.iphone": "どんな文章も学習素材に",
        "read.subheadline.iphone": "単語をタップし、発見を保存し、流れを止めずに読み続ける。",
        "read.featureTitle.iphone": "すぐに調べる",
        "read.featureBody.iphone": "定義とメモが、大切な本文のすぐ近くに残ります。",
        "read.eyebrow.iphone.conversion": "流れを止めずに読む",
        "read.headline.iphone.conversion": "読みたい記事からそのまま学べる",
        "read.subheadline.iphone.conversion": "単語をタップして保存し、場所を見失わずに文へ戻れます。",
        "read.featureTitle.iphone.conversion": "勢いを保つ設計",
        "read.featureBody.iphone.conversion": "同じスクリーンショットを使いながら、App Store向けコピーを検証できます。",
        "read.eyebrow.ipad": "文脈で学ぶ",
        "read.headline.ipad": "読書と復習を並べて表示",
        "read.subheadline.ipad": "広い画面でノート、ハイライト、語彙をまとめて確認できます。",
        "read.featureTitle.ipad": "集中できる作業空間",
        "read.featureBody.ipad": "同じシーンテンプレートで、ターゲット別の素材とコピーを使えます。",
        "read.eyebrow.mac": "復習",
        "read.headline.mac": "学んだことをライブラリに",
        "read.subheadline.mac": "Mac用のスクリーンショットも、同じデータモデルでデスクトップ向けに表現できます。",
        "read.featureTitle.mac": "復習ダッシュボード",
        "read.featureBody.mac": "このデモは公開サンプル用の架空アセットだけを使っています。"
      }
    }
  ]
}
